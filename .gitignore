# Environment / secrets
.env
.env.*
!.env.example
config/secrets/
secrets/

# Databases
*.db
*.sqlite3

# Runtime append-only logs (event/trade history) — not committed, but the
# directory itself is tracked via data/.gitkeep so a fresh checkout has it.
data/*.jsonl

# DailyTradeGuard's persisted dedup snapshot — runtime state, not code.
data/trade_guard_state.json

# OpenPositionsIndex's persisted entry/exit pairing snapshot — runtime
# state, not code.
data/open_positions_index.json

# Logs
*.log

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
